{
  "lintOnSave": false,
  "lintOnFileContentChange": false,
  "displayMessageOnLintOnSave": false,
  "foldersToIgnore": [],
  "filesToIgnore": [],
  "headerIncrements": 1,
  "minimumHeaderLevel": 1,
  "maximumHeaderLevel": 6,
  "defaultLocation": "frontmatter",
  "header": "",
  "footer": "",
  "lineBreakStyle": "unix",
  "ruleEnabled": {
    "yaml-key-sort": false,
    "yaml-key-remove-quotes": false,
    "yaml-timestamp": false,
    "yaml-convert-links": false,
    "paragraph-blank-lines": true,
    "blank-lines-before-headings": true,
    "heading-blank-lines": false,
    "multiple-h1": false,
    "consistent-heading-capitalization": false,
    "capitalize-headings": false,
    "file-empty-line": false,
    "trailing-spaces": true,
    "unordered-list-style": false,
    "indentation": false
  }
}
