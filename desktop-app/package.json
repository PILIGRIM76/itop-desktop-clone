{
  "name": "itop-easy-desktop-clone",
  "version": "1.0.0",
  "description": "iTop Easy Desktop Clone - Desktop Organizer for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "dist": "electron-builder --publish=never",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "desktop",
    "organizer",
    "windows"
  ],
  "author": "iTop Clone",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.itopclone.desktop",
    "productName": "iTop Easy Desktop Clone",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "supabase-client.js",
      "account-manager.js",
      "ai-client.js",
      "ai-config.js",
      "wallpaper-manager.js",
      "wallpaper-creator.js",
      "calendar-sync.js",
      "taskbar-customizer.js",
      "cursor-customizer.js",
      "desktop-window-manager.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "iTop Easy Desktop Clone"
    }
  }
}
